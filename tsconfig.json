{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"],
    "resolveJsonModule": true
  },
  "include": [
    "tests/**/*.ts",
    "config/**/*.ts",
    "Page/**/*.ts",
    "utils/**/*.ts",
    "playwright.config.ts"
  ]
}
